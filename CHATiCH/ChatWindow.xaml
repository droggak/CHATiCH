<Window x:Class="CHATiCH.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CHATiCH"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        Title="Чат" Height="600" Width="900">

    <Window.Resources>
        <!-- Стиль для MarkdownScrollViewer -->
        <Style x:Key="MarkdownStyle" TargetType="md:MarkdownScrollViewer">
            <Style.Resources>
                <Style TargetType="Image">
                    <Setter Property="Width" Value="30"/>
                    <Setter Property="Height" Value="30"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Стиль для контекстного меню -->
        <Style x:Key="NoHoverMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>



    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: статус и контакты -->
        <DockPanel Grid.Column="0" Margin="5">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Height="92">
                <ComboBox x:Name="StatusComboBox" SelectionChanged="StatusComboBox_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="Онлайн" Tag="Online"/>
                    <ComboBoxItem Content="Отошел" Tag="Away"/>
                </ComboBox>

                <TextBox x:Name="StatusMessageBox"
         Margin="0,5,0,0"
         Text="Online via WPF"
         LostFocus="StatusMessageBox_LostFocus"/>

                <Label x:Name="label" Content="Поиск" Width="46" VerticalContentAlignment="Stretch" HorizontalAlignment="Left"/>
                <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" 
                         Width="210" 
                         Height="19" HorizontalAlignment="Left" />
            </StackPanel>

            <ListBox x:Name="ContactsList"
                     ItemsSource="{Binding Contacts}"
                     MouseDoubleClick="ContactsList_MouseDoubleClick" SelectionChanged="ContactsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,5,0"
                                     Fill="{Binding StatusBrush}"/>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text=" (" Margin="5,0,0,0"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="Gray"/>
                            <TextBlock Text=")" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Правая колонка: чаты -->
        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="ChatTabs" Grid.Row="0" SelectionChanged="ChatTab_SelectionChanged">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="История" Click="OpenHistory_Click"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <TextBlock Text="{Binding Header}" Margin="0,0,5,0"/>
                            <Button Content="x"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Label DockPanel.Dock="Bottom" Content="{Binding TypingText}" Foreground="Gray" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox ItemsSource="{Binding Content}"
                                         Margin="5"
                                         BorderThickness="0"
                                         Background="White"
                                         x:Name="MessagesList">
                                    <i:Interaction.Behaviors>
                                        <local:AutoScrollBehavior />
                                    </i:Interaction.Behaviors>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:ChatMessage}">
                                            <StackPanel Orientation="Vertical" Margin="0,2">
                                                <TextBlock FontWeight="Bold"
                                                           Foreground="{Binding AuthorBrush}"
                                                           Text="{Binding Author}" />
                                                <md:MarkdownScrollViewer Markdown="{Binding Text}">
                                                    <md:MarkdownScrollViewer.Resources>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Width" Value="20"/>
                                                            <Setter Property="Height" Value="20"/>
                                                        </Style>
                                                    </md:MarkdownScrollViewer.Resources>
                                                </md:MarkdownScrollViewer>




                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm}'}"
                                                               FontSize="10" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding ReceiptText}"
                                                               FontSize="10" Foreground="Gray" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                <Button x:Name="file_btn" Background="{x:Null}" Width="25" Height="25" Margin="5" BorderThickness="0">
                    <Image Source="paperclip.png" Width="25" Height="25" Margin="0,0,-2,-2" />
                </Button>
                <Button x:Name="emoji_btn" Background="{x:Null}" Width="25" Height="25" Margin="5" BorderThickness="0" Click="EmojiBtn_Click">
                    <Image Source="emoji.png" Width="25" Height="25" Margin="0,0,-2,-2" Stretch="Fill" />
                </Button>
                <RichTextBox x:Name="MessageRichBox"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,5,0"
                             KeyDown="MessageRichBox_KeyDown"
                             TextChanged="MessageRichBox_TextChanged"
                             Width="482" />
                <Button Content="Отправить" Click="SendMessage_Click" Width="100" Height="25" Margin="0,0,0,-2"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
