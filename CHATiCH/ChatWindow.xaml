<Window x:Class="PandionClone.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XMPP Chat" Height="400" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="UsersListBox" Grid.Column="0" SelectionChanged="UsersListBox_SelectionChanged" />

        <StackPanel Grid.Column="1">
            <TextBox x:Name="ChatHistory" Height="250" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
            <TextBox x:Name="InputBox" Height="30" />
            <Button Content="Send" Click="BtnSend_Click" />
        </StackPanel>
    </Grid>
</Window>
