<Window x:Class="CHATiCH.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CHATiCH"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        Title="Чат" Height="600" Width="900"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">
        

    <Window.Resources>
        <!-- Конвертеры -->
        <local:LinkExtractor x:Key="LinkExtractor"/>
        <local:LinkTextExtractor x:Key="LinkTextExtractor"/>
        <local:IncomingMessageBrushConverter x:Key="IncomingMessageBrushConverter"/>
        <local:EditedTextConverter x:Key="EditedTextConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="ProgressBar" x:Key="ModernProgressBar">
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            
        </Style>



        <!-- Стиль для MarkdownScrollViewer -->
        <Style x:Key="MarkdownStyle" TargetType="md:MarkdownScrollViewer">
            <Style.Resources>
                <Style TargetType="Image">
                    <Setter Property="Width" Value="30"/>
                    <Setter Property="Height" Value="30"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Сообщения-ссылки -->
        <DataTemplate x:Key="FileLinkTemplate" DataType="{x:Type local:ChatMessage}">
            <Border CornerRadius="10" Padding="5" Margin="3"
            Background="{Binding IsIncoming, Converter={StaticResource IncomingMessageBrushConverter}}">
                <StackPanel>
                    <!-- Автор -->
                    <TextBlock Text="{Binding Author}" FontWeight="Bold" />

                    <!-- Ссылка на файл -->
                    <TextBlock>
                        <Hyperlink NavigateUri="{Binding FileUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{Binding FileName}" />
                        </Hyperlink>


                    </TextBlock>

                    <!-- Время и статус прочтения -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding EditedText}" Foreground="Gray" FontSize="10" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding Time, StringFormat=HH:mm}" FontSize="10" Foreground="Gray"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>



        <!-- Обычные сообщения -->
        <DataTemplate x:Key="MarkdownTemplate" DataType="{x:Type local:ChatMessage}">
            <Border x:Name="MessageBorder" CornerRadius="10" Padding="5" Margin="3"
            Background="{Binding IsIncoming, Converter={StaticResource IncomingMessageBrushConverter}}">
                <Grid>
                    <!-- Основное содержимое сообщения -->
                    <StackPanel>
                        <!-- Автор -->
                        <TextBlock Text="{Binding Author}" FontWeight="Bold"/>
                        <!-- Пересланное сообщение -->
                        <Border BorderThickness="1" BorderBrush="#DDD" CornerRadius="5" Margin="0,0,0,5" Padding="4"
                                Background="#F5F5F5"
                                Visibility="{Binding IsForwarded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ForwardedFrom}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="Пересланное сообщение:" FontStyle="Italic" Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="{Binding ForwardedText}" TextWrapping="Wrap" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- Markdown текст -->
                        <md:MarkdownScrollViewer Markdown="{Binding DisplayText}" 
                                         Style="{StaticResource MarkdownStyle}" 
                                         VerticalScrollBarVisibility="Hidden"/>

                        <Separator Margin="0,2,0,2"/>

                        <!-- Время и статус -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding IsEdited, Converter={StaticResource EditedTextConverter}}" 
                               FontSize="10" Foreground="Gray" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Time, StringFormat=HH:mm}" FontSize="10" Foreground="Gray"/>
                            <TextBlock Text=" " />
                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>

                    
                    <!-- Кнопка эмодзи (слева сверху, скрыта по умолчанию) -->
                    <Button x:Name="EmojiButton"
                    Content="😊"
                    Width="25"
                    Height="25"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="5"
                    Visibility="Collapsed"
                    Click="EmojiButton_Click"/>

                    <!-- Эмодзи реакции снизу справа -->
                    <ItemsControl ItemsSource="{Binding Reactions}" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Width="15" Height="15" Margin="0.5"
                   MouseLeftButtonDown="ReactionImage_MouseLeftButtonDown"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <!-- Контекстное меню с редактированием, пересылкой, ответом -->
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Редактировать" Click="EditMessage_Click"/>
                        <MenuItem Header="Переслать" Click="ForwardMessage_Click"/>
                        <MenuItem Header="Ответить" Click="ReplyMessage_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="EmojiButton"
                                                       Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="EmojiButton"
                                                       Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Hidden}"/>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
            
        </DataTemplate>







        <!-- Подключаем селектор -->
        <local:MessageTemplateSelector x:Key="MessageTemplateSelector"
                                   MarkdownTemplate="{StaticResource MarkdownTemplate}"
                                   FileLinkTemplate="{StaticResource FileLinkTemplate}" />

        <!-- Стиль для контекстного меню -->
        <Style x:Key="NoHoverMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>




    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: статус и контакты -->
        <DockPanel Grid.Column="0" Margin="5">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Height="92">
                <ComboBox x:Name="StatusComboBox" SelectionChanged="StatusComboBox_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="Онлайн" Tag="Online"/>
                    <ComboBoxItem Content="Отошел" Tag="Away"/>
                </ComboBox>

                <TextBox x:Name="StatusMessageBox"
                         Margin="0,5,0,0"
                         Text="Online via WPF"
                         LostFocus="StatusMessageBox_LostFocus"/>

                <Label x:Name="label" Content="Поиск" Width="46" VerticalContentAlignment="Stretch" HorizontalAlignment="Left"/>
                <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" 
                         Width="210" 
                         Height="19" HorizontalAlignment="Left" />
            </StackPanel>

            <TreeView x:Name="ContactsTree"
          ItemsSource="{Binding ContactGroups}"
          MouseDoubleClick="ContactsTree_MouseDoubleClick">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Contacts}">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>

                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Margin="0,0,5,0" Fill="{Binding StatusBrush, Mode=OneWay}"/>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text=" (" Margin="5,0,0,0"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="Gray"/>
                                    <TextBlock Text=")" />
                                    <ToggleButton IsChecked="{Binding IsFavorite}" 
                                      Width="16" Height="16" Margin="5,0,0,0"
                                      ToolTip="Добавить в избранное">
                                        <Image Source="star.png"/>
                                    </ToggleButton>
                                    <Border Background="Red" CornerRadius="7" Width="14" Height="14" Margin="5,0,0,0"
                                Visibility="{Binding UnreadIndicatorVisibility}">
                                        <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>


        </DockPanel>

        <!-- Правая колонка: чаты -->
        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="ChatTabs" Grid.Row="0" SelectionChanged="ChatTab_SelectionChanged">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="История" Click="OpenHistory_Click"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>

                            <TextBlock Text="{Binding Header}" Margin="0,0,5,0"/>

                            <!-- Индикатор новых сообщений -->
                            <Border Background="Red" CornerRadius="7" Width="14" Height="14" Margin="2,0,0,0"
                                     Visibility="{Binding UnreadIndicatorVisibility}">
                                <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Button Content="x"
                                 Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="{Binding}"/>
                        </StackPanel>

                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Label DockPanel.Dock="Bottom" Content="{Binding TypingText}" Foreground="Gray" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="MessagesList"
                                             Margin="5"
                                             BorderThickness="0"
                                             Background="White"
                                             ItemsSource="{Binding Content}">

                                    <i:Interaction.Behaviors>
                                        <local:AutoScrollBehavior />
                                    </i:Interaction.Behaviors>

                                    <ListBox.ItemTemplateSelector>
                                        <StaticResource ResourceKey="MessageTemplateSelector"/>
                                    </ListBox.ItemTemplateSelector>


                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="5">
                <Border x:Name="FilePreviewPanel"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6"
                        Margin="0,0,0,5"
                        Background="#F9F9F9"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Информация о файле -->
                        <StackPanel>
                            <TextBlock x:Name="SelectedFileText" Visibility="Collapsed" />
                            <TextBlock x:Name="SelectedFileName" Text="file.txt" FontWeight="Bold" />
                            <TextBlock x:Name="SelectedFileSize" Text="12.4 MB" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                            <ProgressBar x:Name="FileUploadProgressBar"
                                 Minimum="0" Maximum="100"
                                 Style="{StaticResource ModernProgressBar}"
                                 Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Кнопка отмены -->
                        <Button x:Name="CancelAttachmentButton"
                                Grid.Column="1"
                                Content="❌"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="Gray"
                                FontSize="14"
                                ToolTip="Отменить вложение"
                                Click="CancelAttachmentButton_Click"/>
                        
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="file_btn" Width="25" Height="25" Margin="5" BorderThickness="0">
                        <Image Source="paperclip.png" Width="25" Height="25"/>
                    </Button>
                    <Button x:Name="emoji_btn" Width="25" Height="25" Margin="5" BorderThickness="0" Click="EmojiBtn_Click">
                        <Image Source="emoji.png" Width="25" Height="25"/>
                    </Button>
                    <RichTextBox x:Name="MessageRichBox"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Width="482"
                                 TextChanged="MessageRichBox_TextChanged"
                                 KeyDown="MessageRichBox_KeyDown"/>
                    <Button Content="Отправить" Click="SendMessage_Click" Width="100" Height="25" Margin="0,0,0,-2"/>
                </StackPanel>
            </StackPanel>
            <!-- Затенение при Drag&Drop -->
            <Border x:Name="DropOverlay"
             Grid.ColumnSpan="2"
             Background="#AA000000"  
             Visibility="Collapsed"
             CornerRadius="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MouseDown="DropOverlay_MouseDown">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.FontSize="20">
                    <TextBlock Text="📎 Чтобы прикрепить файл" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="перетащите его в эту область" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>