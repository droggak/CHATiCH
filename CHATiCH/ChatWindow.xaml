<Window x:Class="CHATiCH.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CHATiCH"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        Title="Чат" Height="600" Width="900">
    <Window.Resources>
        <!-- Конвертеры больше не нужны -->
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: статус и контакты -->
        <DockPanel Grid.Column="0" Margin="5">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Height="92">
                <ComboBox x:Name="StatusComboBox" SelectionChanged="StatusComboBox_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="Онлайн" Tag="Online"/>
                    <ComboBoxItem Content="Отошел" Tag="Away"/>
                </ComboBox>
                <TextBox x:Name="StatusMessageBox"
                         Margin="0,5,0,0"
                         Text="Online via WPF"
                         LostFocus="StatusMessageBox_LostFocus"/>
                <Label x:Name="label" Content="Поиск" Width="46" VerticalContentAlignment="Stretch" HorizontalAlignment="Left"/>
                <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" 
                         RenderTransformOrigin="0.5,0.5" 
                         Width="210" 
                         Height="19" HorizontalAlignment="Left" >
                    <TextBox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                            <SkewTransform/>
                            <RotateTransform Angle="180"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TextBox.RenderTransform>
                </TextBox>
            </StackPanel>

            <ListBox x:Name="ContactsList"
                     ItemsSource="{Binding Contacts}"
                     MouseDoubleClick="ContactsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <!-- Используем StatusBrush напрямую -->
                            <Ellipse Width="10" Height="10" Margin="0,0,5,0"
                                     Fill="{Binding StatusBrush}"/>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text=" (" Margin="5,0,0,0"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="Gray"/>
                            <TextBlock Text=")" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Правая колонка: чаты -->
        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="ChatTabs" Grid.Row="0" SelectionChanged="ChatTab_SelectionChanged">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="История" Click="OpenHistory_Click"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <TextBlock Text="{Binding Header}" Margin="0,0,5,0"/>
                            <Button Content="x"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Padding="0"
                                    Width="16" Height="16"
                                    Margin="5,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Label DockPanel.Dock="Bottom" Content="{Binding TypingText}" Foreground="Gray" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox ItemsSource="{Binding Content}"
                                         Margin="5"
                                         BorderThickness="0"
                                         Background="White"
                                         x:Name="MessagesList">
                                    <i:Interaction.Behaviors>
                                        <local:AutoScrollBehavior />
                                    </i:Interaction.Behaviors>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:ChatMessage}">
                                            <StackPanel Orientation="Vertical" Margin="0,2">
                                                <!-- Используем AuthorBrush напрямую -->
                                                <TextBlock FontWeight="Bold"
                                                           Foreground="{Binding AuthorBrush}"
                                                           Text="{Binding Author}" />
                                                <md:MarkdownScrollViewer Markdown="{Binding Text}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm}'}"
                                                               FontSize="10" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding ReceiptText}"
                                                               FontSize="10" Foreground="Gray" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                <TextBox x:Name="MessageTextBox" Width="400" Margin="0,0,5,0" 
                         KeyDown="MessageTextBox_KeyDown" TextChanged="MessageTextBox_TextChanged"/>
                <Button Content="Отправить" Click="SendMessage_Click" Width="100"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
