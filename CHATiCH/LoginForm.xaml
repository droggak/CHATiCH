<Window x:Class="CHATiCH.LoginForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="200" Width="300">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Username:" />
            <TextBox x:Name="txtUsername" />
            <TextBlock Text="Password:" />
            <PasswordBox x:Name="txtPassword" />
            <TextBlock Text="Domain:" />
            <TextBox x:Name="txtDomain" Text="win-m4f2mfrj6i4.vkr.loc" />
            <!-- Значение по умолчанию для теста -->
            <Button Content="Login" Click="BtnLogin_Click" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</Window>