<Window x:Class="CHATiCH.LoginForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="507" Width="350"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" Color="#AAAAAA" BlurRadius="8" ShadowDepth="3" Opacity="0.5"/>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,5,10,5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#007BFF"/>
                    <Setter Property="Effect" Value="{StaticResource DropShadowEffect}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,5,10,5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#007BFF"/>
                    <Setter Property="Effect" Value="{StaticResource DropShadowEffect}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#555555"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#007BFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="0,0,0,26">
        <Border CornerRadius="5" Background="White" Padding="20" Margin="20,20,20,0" 
                Effect="{DynamicResource DropShadowEffect}">
            <StackPanel>
                <TextBlock Text="Login" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#333333"/>

                <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555555"/>
                <TextBox x:Name="txtUsername" />

                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,15,0,5" Foreground="#555555"/>
                <PasswordBox x:Name="txtPassword" />

                <TextBlock Text="Domain" FontWeight="SemiBold" Margin="0,15,0,5" Foreground="#555555"/>
                <TextBox x:Name="txtDomain" Text="win-m4f2mfrj6i4.vkr.loc" />

                <CheckBox x:Name="chkRememberMe" Content="Запомнить меня" Margin="0,15,0,0" />

                <CheckBox x:Name="chkRememberPassword" Content="Запомнить пароль (небезопасно)" Margin="0,5,0,0" />

                <Button Content="Login" Click="BtnLogin_Click" Height="35" 
                        Margin="0,20,0,0" Background="#007BFF" Foreground="White" 
                        FontWeight="Bold" BorderThickness="0" Cursor="Hand" IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#007BFF"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0056B3"/>
                                    <Setter Property="Effect" Value="{StaticResource DropShadowEffect}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#004085"/>
                                    <Setter Property="Effect" Value="{StaticResource DropShadowEffect}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>