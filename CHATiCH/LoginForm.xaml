<Window x:Class="CHATiCH.LoginForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="430" Width="350"
        WindowStartupLocation="CenterScreen"
        Background="#F9F9F9">
    <Grid Margin="0,0,0,26">
        <Border CornerRadius="10" Background="White" Padding="20" Margin="20,20,20,0" 
                Effect="{DynamicResource DropShadowEffect}">
            <StackPanel>
                <TextBlock Text="Login" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsername" Height="30" 
                         Padding="5" BorderBrush="#DDD" BorderThickness="1" 
                         Background="#FFF" />

                <TextBlock Text="Password" FontWeight="SemiBold" Margin="10,10,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="30" 
                             Padding="5" BorderBrush="#DDD" BorderThickness="1" 
                             Background="#FFF" />

                <TextBlock Text="Domain" FontWeight="SemiBold" Margin="10,10,0,5"/>
                <TextBox x:Name="txtDomain" Height="30" Text="win-m4f2mfrj6i4.vkr.loc"
                         Padding="5" BorderBrush="#DDD" BorderThickness="1" 
                         Background="#FFF" />

                <Button Content="Login" Click="BtnLogin_Click" Height="35" 
                        Margin="0,20,0,0" Background="#4CAF50" Foreground="White" 
                        FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4CAF50"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#45A049"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#3E8E41"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>

    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect" Color="#888" BlurRadius="10" ShadowDepth="3"/>
    </Window.Resources>
</Window>
