<Window x:Class="PandionClone.LoginForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XMPP Login" Height="250" Width="300">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Username" />
            <TextBox x:Name="txtUsername" />
            <PasswordBox x:Name="txtPassword" Margin="0,0,0,10"/>
            <TextBox x:Name="txtDomain" Text="win-m4f2mfrj6i4.vkr.loc" Margin="0,0,0,10"/>
            <Button Content="Login" Click="BtnLogin_Click" />
        </StackPanel>
    </Grid>
</Window>
