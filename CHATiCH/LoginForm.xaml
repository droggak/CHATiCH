<Window x:Class="CHATiCH.LoginForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="520" Width="360"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9FC"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Тень для элементов -->
        <DropShadowEffect x:Key="DropShadowEffect" Color="#888888" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>

        <!-- Кнопка Login -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#357ABD"/>
                    <Setter Property="Effect" Value="{StaticResource DropShadowEffect}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2A5D9F"/>
                    <Setter Property="Effect" Value="{StaticResource DropShadowEffect}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Чекбоксы -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#4A90E2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="10" Background="White" Padding="25" Margin="20" 
                Effect="{DynamicResource DropShadowEffect}">
            <StackPanel>
                <TextBlock Text="Login" FontSize="28" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,25" Foreground="#333333"/>

                <!-- Username -->
                <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#555555"/>
                <Border CornerRadius="6" Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
                    <TextBox x:Name="txtUsername" Background="Transparent" BorderThickness="0" Padding="10,5"/>
                </Border>

                <!-- Password -->
                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,15,0,5" Foreground="#555555"/>
                <Border CornerRadius="6" Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
                    <PasswordBox x:Name="txtPassword" Background="Transparent" BorderThickness="0" Padding="10,5"/>
                </Border>

                <!-- Domain -->
                <TextBlock Text="Domain" FontWeight="SemiBold" Margin="0,15,0,5" Foreground="#555555"/>
                <Border CornerRadius="6" Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
                    <TextBox x:Name="txtDomain" Text="win-m4f2mfrj6i4.vkr.loc" Background="Transparent" BorderThickness="0" Padding="10,5"/>
                </Border>

                <!-- Checkboxes -->
                <CheckBox x:Name="chkRememberMe" Content="Запомнить меня" Margin="0,15,0,0"/>
                <CheckBox x:Name="chkRememberPassword" Content="Запомнить пароль (небезопасно)" Margin="0,5,0,0"/>

                <!-- Login Button -->
                <Button Content="Login" Click="BtnLogin_Click" Margin="0,20,0,0" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
