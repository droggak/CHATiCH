<Window x:Class="CHATiCH.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        Title="История сообщений" Height="550" Width="900"
        Background="#F5F7FA">

    <Window.Resources>


        <DropShadowEffect x:Key="DropShadowEffect"
                          Color="#888" BlurRadius="12"
                          ShadowDepth="3" Opacity="0.35"/>


        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>


        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#357ABD"/>
                    <Setter Property="Effect" Value="{StaticResource DropShadowEffect}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2A5D9F"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="ComboBox" x:Key="ModernComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <!-- Текст -->
                                    <ContentPresenter
                                        Margin="8,0,32,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Content="{TemplateBinding SelectionBoxItem}"/>

                                    <!-- Стрелка справа -->
                                    <ToggleButton x:Name="DropDownToggle"
                                                  Width="30"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Cursor="Hand"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" Height="17" Margin="172,0,0,0">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 0 0 L 8 0 L 4 5 Z"
                                                  Fill="#333"
                                                  Width="12" Margin="0,4,0,4" Stretch="Fill"/>
                                        </Grid>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- Выпадающий список -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="White"
                                        BorderBrush="#CCCCCC"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, ElementName=MainBorder}"
                                        Effect="{StaticResource DropShadowEffect}">
                                    <ScrollViewer MaxHeight="220">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="ComboBoxItem" x:Key="ModernComboBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF6FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D6EAFB"/>
                                <Setter Property="Foreground" Value="#0B5FA5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="Border" x:Key="MessageItemBorder">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource DropShadowEffect}"/>
        </Style>

    </Window.Resources>



    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,12,0"
                Effect="{StaticResource DropShadowEffect}">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top">

                    <Label Content="Выберите дату:"/>
                    <Calendar x:Name="DateCalendar"
                              SelectedDatesChanged="DateCalendar_SelectedDatesChanged"
                              Margin="0,0,0,10"/>

                    <Label Content="Тип сообщений:"/>
                    <ComboBox x:Name="TypeFilter"
                              Margin="0,0,0,10"
                              Style="{StaticResource ModernComboBox}"
                              ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                              SelectionChanged="TypeFilter_SelectionChanged">
                        <ComboBoxItem Content="Все" Tag="all" IsSelected="True"/>
                        <ComboBoxItem Content="Входящие" Tag="incoming"/>
                        <ComboBoxItem Content="Исходящие" Tag="outgoing"/>
                    </ComboBox>

                    <Label Content="Поиск:"/>
                    <TextBox x:Name="SearchBox"
                             Height="30"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="Введите текст для поиска"/>
                </StackPanel>

                <Button Content="Экспорт"
                        DockPanel.Dock="Bottom"
                        Margin="0,20,0,0"
                        Click="Export_Click"/>
            </DockPanel>
        </Border>


        <Border Grid.Column="1"
                Background="White"
                CornerRadius="10"
                Padding="10"
                Effect="{StaticResource DropShadowEffect}">
            <Grid>
                <ListBox x:Name="MessagesList"
                         ItemsSource="{Binding FilteredMessages}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MessageItemBorder}">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" FontSize="14"
                                               Text="{Binding Author}"/>

                                    <md:MarkdownScrollViewer
                                        Markdown="{Binding Text}"
                                        FontSize="13"
                                        Margin="0,6,0,6"/>

                                    <TextBlock Text="{Binding Time, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                               FontSize="11"
                                               Foreground="Gray"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyLabel"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontStyle="Italic"
                           Foreground="Gray"
                           Text="Нет сообщений для выбранных условий."
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>

</Window>
