<Window x:Class="CHATiCH.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История сообщений" Height="500" Width="800">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список дат -->
        <ListBox x:Name="DatesList"
                 Grid.Column="0"
                 SelectionChanged="DatesList_SelectionChanged"
                 Margin="5"/>

        <!-- Сообщения -->
        <ListBox Grid.Column="1"
                 ItemsSource="{Binding Messages}"
                 Margin="5"
                 BorderThickness="0"
                 Background="White">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="0,2">
                        <TextBlock FontWeight="Bold" Text="{Binding Author}"/>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Time, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                   FontSize="10" Foreground="Gray"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
